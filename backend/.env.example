# Environment Variables
NODE_ENV=development
PORT=5000

# Database PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=CAMBIAR_CONTRASENA_MANTENIMIENTO
DB_SSL=false
DB_TIMEZONE=-06:00

DB_APP_USER=jyr_app
DB_APP_PASSWORD=CAMBIAR_CONTRASENA_APP

DB_MAINTENANCE_USER=postgres
DB_MAINTENANCE_PASSWORD=CAMBIAR_CONTRASENA_MANTENIMIENTO

# JWT
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
JWT_EXPIRES_IN=30m

# Login rate limiting
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_TUNNEL_ORIGINS=false

# Backups
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_UPLOAD_MB=512
