# Copia este archivo a .env.tunnel y completa los valores
# .env.tunnel NO se sube al repositorio (esta en .gitignore)

# Token del Named Tunnel de Cloudflare (estable)
TUNNEL_TOKEN=

# URL publica fija que configuraste en Cloudflare para tu app
# Ejemplo: https://app.tudominio.com
TUNNEL_PUBLIC_URL=
